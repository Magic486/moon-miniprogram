.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部品牌区 */
.hero {
  background: linear-gradient(135deg, #B4232C, #8E1B23);
  padding: 70rpx 40rpx 90rpx;
  color: #fff;
  border-radius: 0 0 48rpx 48rpx;
}

.hero-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 主卡片 */
.card {
  margin: -50rpx 32rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 44rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 41, 51, 0.08);
}

.field-label {
  font-size: 24rpx;
  color: #8A94A6;
  letter-spacing: 1rpx;
}

.amount-input {
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #1F2933;
  height: 96rpx;
}

.ph {
  color: #C2C9D4;
  font-weight: 400;
  font-size: 40rpx;
}

.divider {
  height: 1rpx;
  background: #EDEFF3;
  margin: 28rpx 0;
}

.upper {
  margin-top: 14rpx;
  min-height: 96rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #C2C9D4;
  word-break: break-all;
}

.upper.ok {
  color: #B4232C;
}

.hint {
  font-size: 24rpx;
  color: #8A94A6;
}

.hint.hide {
  color: #2E7D32;
}

.hint.hide::before {
  content: "✓ ";
}

.btn-copy {
  margin-top: 36rpx;
  background: #B4232C;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  line-height: 96rpx;
}

.btn-copy.disabled {
  background: #E3E5EA;
  color: #A6ADBB;
}

/* 快捷示例 */
.samples {
  margin: 36rpx 32rpx 0;
}

.sample-title {
  font-size: 24rpx;
  color: #8A94A6;
  margin-bottom: 18rpx;
}

.sample-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sample {
  background: #fff;
  border: 1rpx solid #EDEFF3;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #4B5563;
}

.sample:active {
  background: #FDF0EF;
  border-color: #B4232C;
  color: #B4232C;
}

/* 底部链接 */
.link {
  display: block;
  text-align: center;
  margin-top: 44rpx;
  color: #8A94A6;
  font-size: 26rpx;
}
