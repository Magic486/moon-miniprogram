<view class="page">
  <view class="hero">
    <view class="hero-badge">¥</view>
    <view class="hero-title">人民币大写金额</view>
    <view class="hero-sub">MoonBit 驱动 · 央行规范 · 离线可用</view>
  </view>

  <view class="card">
    <view class="field-label">金额（元）</view>
    <input
      class="amount-input"
      type="digit"
      value="{{input}}"
      bindinput="onInput"
      placeholder="输入金额，如 1680.32"
      placeholder-class="ph"
    />

    <view class="divider" />

    <view class="field-label">大写金额</view>
    <view class="upper {{valid ? 'ok' : ''}}">{{upper ? upper : '—'}}</view>
    <view class="hint {{valid ? 'hide' : ''}}">{{hint}}</view>

    <button class="btn-copy {{valid ? '' : 'disabled'}}" bindtap="onCopy" disabled="{{!valid}}">
      复制大写金额
    </button>
  </view>

  <view class="samples">
    <view class="sample-title">试一试</view>
    <view class="sample-list">
      <view
        class="sample"
        wx:for="{{samples}}"
        wx:key="*this"
        data-v="{{item}}"
        bindtap="onSample"
      >{{item}}</view>
    </view>
  </view>

  <navigator class="link" url="/pages/history/history">查看复制历史 →</navigator>
</view>
