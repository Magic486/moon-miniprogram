<view class="page">
  <view class="head">
    <text class="head-title">复制历史</text>
    <text
      wx:if="{{items.length > 0}}"
      class="head-clear"
      bindtap="onClear"
    >清空</text>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty">
    <view class="empty-icon">🧾</view>
    <view class="empty-text">暂无历史</view>
    <view class="empty-sub">复制大写金额后会自动记录在这里</view>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="upper"
    class="item"
    data-upper="{{item.upper}}"
    bindtap="onItemTap"
  >
    <view class="item-upper">{{item.upper}}</view>
    <view class="item-input">￥{{item.input}} · 点按再次复制</view>
  </view>
</view>
