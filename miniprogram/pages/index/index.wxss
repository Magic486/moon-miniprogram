.page { padding: 40rpx 32rpx 64rpx; }
.hero { display: flex; flex-direction: column; margin: 20rpx 8rpx 36rpx; }
.eyebrow { color: #0f766e; font-size: 22rpx; font-weight: 700; letter-spacing: 4rpx; }
.title { margin-top: 12rpx; font-size: 52rpx; font-weight: 800; }
.subtitle { margin-top: 16rpx; color: #64748b; font-size: 27rpx; line-height: 1.6; }
.card { margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #e2e8f0; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, .06); }
.counter-card { text-align: center; }
.label { display: block; margin-bottom: 20rpx; color: #64748b; font-size: 24rpx; font-weight: 600; }
.count { display: block; color: #0f766e; font-size: 112rpx; font-weight: 800; line-height: 1.1; }
.hint { display: block; margin: 18rpx 0 30rpx; color: #94a3b8; font-size: 23rpx; }
.row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.value { color: #0f766e; font-size: 44rpx; font-weight: 800; }
.result { display: block; margin-top: 20rpx; color: #475569; font-size: 25rpx; }
.primary { background: #0f766e; color: #fff; }
.actions { display: grid; gap: 18rpx; }
